---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { portfolio, resumePath, portraitPath } from '../data/portfolio';

const { personal, skills, languages, experiences, projects, education, certifications } = portfolio;

const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title={`${personal.name} | ${personal.title}`}
  description={`${personal.name} is a software engineer in Shah Alam, Malaysia, working on hospital management systems, HL7 integrations and clinical APIs.`}
>
  <Nav />

  <main id="main">
    <!-- MASTHEAD -->
    <section id="top" class="mx-auto max-w-5xl px-5 pt-14 pb-12 sm:px-8 sm:pt-20">
      <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-start md:gap-16">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
            Portfolio, revised November 2026
          </p>

          <h1 class="mt-5 font-serif text-[2.6rem] leading-[1.02] tracking-tight text-ink sm:text-6xl lg:text-7xl">
            Muhammad Safiyan Roslan
          </h1>

          <p class="mt-4 text-lg text-muted">{personal.title}, {personal.location}</p>

          <p class="mt-6 max-w-[46ch] text-[17px] leading-relaxed text-ink">
            I build the systems hospitals run on: laboratory and radiology workflows, medical
            records, and the HL7 links that carry orders and results between them.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a
              href="#projects"
              class="inline-flex min-h-11 items-center bg-accent px-5 text-sm font-medium text-white transition-colors hover:bg-accent-deep"
            >
              See selected work
            </a>
            <a href={resumePath} class="link-ink text-sm text-accent-deep">
              Download resume (PDF)
            </a>
          </div>
        </div>

        <figure class="w-[152px] shrink-0">
          <img
            src={portraitPath}
            width="264"
            height="298"
            alt="Portrait of Muhammad Safiyan Roslan"
            fetchpriority="high"
            class="block h-auto w-full"
          />
        </figure>
      </div>

      <!-- Ledger strip replacing the usual stat cards -->
      <dl class="mt-14 grid gap-y-4 border-y border-rule py-5 sm:grid-cols-3 sm:gap-x-8">
        <div>
          <dt class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">Current role</dt>
          <dd class="mt-1 text-sm">Software Engineer, MSU</dd>
        </div>
        <div>
          <dt class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">Working since</dt>
          <dd class="mt-1 text-sm">January 2023</dd>
        </div>
        <div>
          <dt class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">Domain</dt>
          <dd class="mt-1 text-sm">Hospital systems, HL7, APIs</dd>
        </div>
      </dl>
    </section>

    <!-- 01 PROFILE -->
    <section id="about" class="mx-auto max-w-5xl px-5 py-14 sm:px-8">
      <SectionHeading index="01" title="Profile" />

      <div class="mt-8 grid gap-10 md:grid-cols-[1.6fr_1fr] md:gap-16">
        <div class="space-y-4 text-[17px] leading-relaxed text-ink">
          <p>{personal.summary}</p>
          <p class="text-muted">
            The work is mostly integration: getting a hospital system, a laboratory system, a PACS
            and a state records platform to agree on the same patient, the same order and the same
            result, then keeping that agreement stable in production.
          </p>
        </div>

        <dl class="space-y-3 border-t border-rule pt-4 text-sm">
          <div class="flex justify-between gap-4 border-b border-rule pb-3">
            <dt class="text-muted">Based in</dt>
            <dd class="text-right">{personal.location}</dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-rule pb-3">
            <dt class="text-muted">Email</dt>
            <dd class="text-right">
              <a href={`mailto:${personal.email}`} class="link-ink break-all">{personal.email}</a>
            </dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-rule pb-3">
            <dt class="text-muted">LinkedIn</dt>
            <dd class="text-right">
              <a href={personal.linkedin} target="_blank" rel="noopener noreferrer" class="link-ink">
                {personal.linkedinDisplay}
              </a>
            </dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-muted">Degree</dt>
            <dd class="text-right">BSc Computer Science, CGPA 3.66</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- 02 CAPABILITIES -->
    <section id="skills" class="mx-auto max-w-5xl px-5 py-14 sm:px-8">
      <SectionHeading index="02" title="Capabilities" />

      <dl class="mt-8">
        {skills.map((group) => (
          <div class="grid gap-1 border-b border-rule py-4 sm:grid-cols-[14rem_1fr] sm:gap-8">
            <dt class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
              {group.group}
            </dt>
            <dd class="text-[15px] leading-relaxed text-ink">{group.items.join(', ')}</dd>
          </div>
        ))}
        <div class="grid gap-1 border-b border-rule py-4 sm:grid-cols-[14rem_1fr] sm:gap-8">
          <dt class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">Languages</dt>
          <dd class="text-[15px] text-ink">
            {languages.map((lang, i) => (
              <span>
                {lang.name} ({lang.level.toLowerCase()}){i < languages.length - 1 ? ', ' : ''}
              </span>
            ))}
          </dd>
        </div>
      </dl>
    </section>

    <!-- 03 EXPERIENCE -->
    <section id="experience" class="mx-auto max-w-5xl px-5 py-14 sm:px-8">
      <SectionHeading index="03" title="Experience" />

      <div class="mt-8">
        {experiences.map((exp) => (
          <article class="grid gap-x-8 gap-y-3 border-b border-rule py-7 sm:grid-cols-[9rem_1fr]">
            <p class="font-mono text-xs leading-relaxed text-muted">{exp.period}</p>

            <div>
              <h3 class="font-serif text-xl font-medium tracking-tight text-ink">{exp.role}</h3>
              <p class="mt-1 text-sm text-muted">{exp.company}</p>

              {exp.highlights.length > 0 && (
                <ul class="mt-4 space-y-2">
                  {exp.highlights.map((point) => (
                    <li class="relative pl-5 text-[15px] leading-relaxed text-ink before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2.5 before:bg-muted before:content-['']">
                      {point}
                    </li>
                  ))}
                </ul>
              )}

              {exp.subSections.map((sub) => (
                <div class="mt-5">
                  <h4 class="text-sm font-semibold text-ink">{sub.title}</h4>
                  <ul class="mt-2 space-y-2">
                    {sub.points.map((point) => (
                      <li class="relative pl-5 text-[15px] leading-relaxed text-muted before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2.5 before:bg-rule before:content-['']">
                        {point}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 04 SELECTED WORK -->
    <section id="projects" class="mx-auto max-w-5xl px-5 py-14 sm:px-8">
      <SectionHeading index="04" title="Selected work" />

      <div class="mt-8">
        {projects.map((project, i) => (
          <article class="grid gap-x-8 gap-y-2 border-b border-rule py-7 sm:grid-cols-[3rem_1fr]">
            <p class="font-mono text-xs text-muted">{pad(i + 1)}</p>

            <div>
              <h3 class="font-serif text-xl font-medium tracking-tight text-ink">{project.title}</h3>
              <p class="mt-2 max-w-[60ch] text-[15px] leading-relaxed text-muted">
                {project.description}
              </p>

              <ul class="mt-4 space-y-1.5">
                {project.features.map((feature) => (
                  <li class="relative pl-5 text-[15px] leading-relaxed text-ink before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2.5 before:bg-muted before:content-['']">
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 05 EDUCATION -->
    <section id="education" class="mx-auto max-w-5xl px-5 py-14 sm:px-8">
      <SectionHeading index="05" title="Education" />

      <div class="mt-8">
        {education.map((edu) => (
          <div class="grid gap-1 border-b border-rule py-4 sm:grid-cols-[9rem_1fr_auto] sm:items-baseline sm:gap-8">
            <p class="font-mono text-xs text-muted">{edu.period}</p>
            <div>
              <p class="font-medium text-ink">{edu.degree}</p>
              <p class="mt-0.5 text-sm text-muted">{edu.institution}</p>
            </div>
            <p class="font-mono text-xs text-ink sm:text-right">{edu.result}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 06 CERTIFICATIONS -->
    <section id="certs" class="mx-auto max-w-5xl px-5 py-14 sm:px-8">
      <SectionHeading index="06" title="Certifications and awards" />

      <div class="mt-8">
        {certifications.map((cert) => (
          <div class="grid gap-1 border-b border-rule py-3 sm:grid-cols-[5rem_1fr] sm:gap-8">
            <p class="font-mono text-xs text-muted">{cert.year ?? 'Award'}</p>
            <p class="text-[15px] leading-relaxed text-ink">{cert.title}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 07 CONTACT -->
    <section id="contact" class="mx-auto max-w-5xl px-5 py-14 sm:px-8">
      <SectionHeading
        index="07"
        title="Contact"
        lede="Open to conversations about hospital systems, integration work and backend engineering."
      />

      <div class="mt-8 grid gap-10 md:grid-cols-[1fr_1.4fr] md:gap-16">
        <dl class="space-y-3 self-start border-t border-rule pt-4 text-sm">
          <div class="flex justify-between gap-4 border-b border-rule pb-3">
            <dt class="text-muted">Email</dt>
            <dd class="text-right">
              <a href={`mailto:${personal.email}`} class="link-ink break-all">{personal.email}</a>
            </dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-rule pb-3">
            <dt class="text-muted">LinkedIn</dt>
            <dd class="text-right">
              <a href={personal.linkedin} target="_blank" rel="noopener noreferrer" class="link-ink">
                {personal.linkedinDisplay}
              </a>
            </dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-muted">Location</dt>
            <dd class="text-right">{personal.location}</dd>
          </div>
        </dl>

        <form id="contact-form" data-email={personal.email} novalidate class="space-y-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
                Name
              </label>
              <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
                class="min-h-11 w-full border-b border-rule bg-transparent px-0 py-2 text-[15px] text-ink placeholder:text-muted/70 focus:border-accent focus:outline-none"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="email" class="mb-1.5 block font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
                Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class="min-h-11 w-full border-b border-rule bg-transparent px-0 py-2 text-[15px] text-ink placeholder:text-muted/70 focus:border-accent focus:outline-none"
                placeholder="you@example.com"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="mb-1.5 block font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
              Subject
            </label>
            <input
              id="subject"
              name="subject"
              type="text"
              required
              class="min-h-11 w-full border-b border-rule bg-transparent px-0 py-2 text-[15px] text-ink placeholder:text-muted/70 focus:border-accent focus:outline-none"
              placeholder="What the message is about"
            />
          </div>

          <div>
            <label for="message" class="mb-1.5 block font-mono text-[11px] uppercase tracking-[0.08em] text-muted">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full resize-y border-b border-rule bg-transparent px-0 py-2 text-[15px] leading-relaxed text-ink placeholder:text-muted/70 focus:border-accent focus:outline-none"
              placeholder="Your message"
            ></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
            <button
              type="submit"
              class="inline-flex min-h-11 items-center bg-accent px-5 text-sm font-medium text-white transition-colors hover:bg-accent-deep"
            >
              Send message
            </button>
            <p class="text-sm text-muted">This opens your email app with the message filled in.</p>
          </div>

          <p
            id="form-status"
            role="status"
            aria-live="polite"
            class="hidden border-l-2 border-accent bg-surface px-3 py-2 text-sm text-ink"
          ></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="mx-auto max-w-5xl px-5 py-8 sm:px-8">
    <div class="flex flex-col gap-2 border-t border-rule pt-5 text-sm text-muted sm:flex-row sm:justify-between">
      <p>&copy; 2026 Muhammad Safiyan Roslan</p>
      <p>
        Static build in Astro.{' '}
        <a href="https://github.com/ian9598/myPortfolio" class="link-ink">Laravel version</a>
      </p>
    </div>
  </footer>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');

    form?.addEventListener('submit', (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const values = {
        name: String(data.get('name') ?? '').trim(),
        email: String(data.get('email') ?? '').trim(),
        subject: String(data.get('subject') ?? '').trim(),
        message: String(data.get('message') ?? '').trim(),
      };

      const firstEmpty = (Object.keys(values) as Array<keyof typeof values>).find(
        (key) => !values[key]
      );

      if (!status) return;

      if (firstEmpty) {
        status.textContent = 'Please complete every field before sending.';
        status.classList.remove('hidden');
        form.querySelector<HTMLElement>(`[name="${firstEmpty}"]`)?.focus();
        return;
      }

      status.textContent =
        'Opening your email app with the message ready to send. If nothing opened, email me directly at ' +
        (form.dataset.email ?? '') +
        '.';
      status.classList.remove('hidden');

      const body = `${values.message}\n\n${values.name} (${values.email})`;
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(
        `Portfolio contact: ${values.subject}`
      )}&body=${encodeURIComponent(body)}`;
    });
  </script>
</Base>
