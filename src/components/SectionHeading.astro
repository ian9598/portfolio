---
interface Props {
  index: string;
  title: string;
  lede?: string;
}

const { index, title, lede } = Astro.props;
---

<div class="border-t border-rule pt-4">
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <span class="font-mono text-xs text-accent">{index}</span>
    <h2 class="font-serif text-2xl font-medium tracking-tight text-ink sm:text-3xl">{title}</h2>
  </div>
  {lede && <p class="mt-3 max-w-prose text-[15px] leading-relaxed text-muted">{lede}</p>}
</div>
