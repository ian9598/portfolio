---
interface Props {
  title: string;
  compact?: boolean;
}

const { title, compact = false } = Astro.props;
---

<div class="reveal">
  <h2 class="text-3xl font-bold text-center mb-2">
    <span class="gradient-text">{title}</span>
  </h2>
  <div class={`w-20 h-1 bg-emerald-500 mx-auto rounded-full ${compact ? 'mb-4' : 'mb-12'}`}></div>
</div>
