---
import { portfolio, resumePath } from '../data/portfolio';
---

<header
  id="site-header"
  class="sticky top-0 z-40 border-b border-rule bg-paper/95 backdrop-blur-[2px]"
>
  <div class="mx-auto flex max-w-5xl items-baseline justify-between px-5 py-3 sm:px-8">
    <a href="#top" class="font-serif text-lg font-medium tracking-tight text-ink">
      Safiyan Roslan
    </a>

    <nav aria-label="Sections" class="hidden items-baseline gap-6 md:flex">
      {portfolio.navItems.map((item) => (
        <a href={`#${item.slug}`} class="link-ink text-sm text-muted">{item.label}</a>
      ))}
      <a href={resumePath} class="link-ink text-sm text-accent-deep">Resume</a>
    </nav>

    <button
      id="nav-toggle"
      type="button"
      class="flex items-center gap-2 text-sm text-muted md:hidden"
      aria-expanded="false"
      aria-controls="nav-panel"
    >
      Menu
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <div id="nav-panel" class="hidden border-t border-rule md:hidden">
    <nav aria-label="Sections" class="mx-auto flex max-w-5xl flex-col px-5 py-2">
      {portfolio.navItems.map((item) => (
        <a href={`#${item.slug}`} class="border-b border-rule py-3 text-sm text-muted last:border-0">
          {item.label}
        </a>
      ))}
      <a href={resumePath} class="py-3 text-sm text-accent-deep">Resume</a>
    </nav>
  </div>
</header>
